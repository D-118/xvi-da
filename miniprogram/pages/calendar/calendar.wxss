.cal-head {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.cal-week, .cal-row {
  display: flex;
}
.cal-wk, .cal-cell {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
}
.cal-cell {
  color: #1a1a1a;
  height: 88rpx;
  line-height: 60rpx;
}
