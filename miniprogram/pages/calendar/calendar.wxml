<view class="container">
  <view class="card cal-card">
    <view class="cal-head">{{year}} 年 {{month}} 月</view>
    <view class="cal-week">
      <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="cal-wk">{{item}}</text>
    </view>
    <view class="cal-grid">
      <view wx:for="{{weeks}}" wx:key="index" class="cal-row">
        <view wx:for="{{item}}" wx:for-item="d" wx:key="*this" class="cal-cell">{{d || ''}}</view>
      </view>
    </view>
  </view>
</view>
