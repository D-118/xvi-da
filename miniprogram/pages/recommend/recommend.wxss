.container {
  padding: 24rpx 28rpx 60rpx;
}
.weather-card {
  background: linear-gradient(135deg, #1a1a1a, #3a3a4a);
  color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.w-main {
  display: flex;
  flex-direction: column;
}
.w-temp {
  font-size: 60rpx;
  font-weight: 700;
}
.w-text {
  font-size: 26rpx;
  margin-top: 6rpx;
}
.w-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  max-width: 320rpx;
}
.w-tip {
  font-size: 24rpx;
  text-align: right;
}
.w-mock {
  font-size: 20rpx;
  opacity: 0.6;
}
.scene-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.scene-chip {
  background: #fff;
  color: #555;
  border-radius: 30rpx;
  padding: 12rpx 30rpx;
  font-size: 26rpx;
}
.scene-chip.active {
  background: #1a1a1a;
  color: #fff;
}
.summary {
  font-size: 25rpx;
  color: #666;
  margin-bottom: 22rpx;
}
.combo-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
}
.combo-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.combo-rank {
  font-size: 27rpx;
  font-weight: 600;
}
.combo-rank.top {
  color: #b8860b;
}
.combo-score {
  font-size: 24rpx;
  color: #999;
}
.combo-items {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.combo-img {
  flex: 1;
  height: 200rpx;
  border-radius: 14rpx;
  background: #f0f0f0;
}
.reasons {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.reason {
  font-size: 24rpx;
  color: #666;
}
.adopt-btn {
  background: #1a1a1a;
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
