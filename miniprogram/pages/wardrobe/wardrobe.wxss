.container {
  padding: 24rpx 24rpx 140rpx;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 26rpx;
}
.archive-toggle {
  font-size: 24rpx;
  color: #666;
  background: #fff;
  border-radius: 32rpx;
  padding: 12rpx 20rpx;
  white-space: nowrap;
}
.cat-tabs-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.cat-tabs {
  display: inline-flex;
  gap: 14rpx;
}
.chip {
  display: inline-block;
  background: #fff;
  color: #555;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  font-size: 25rpx;
}
.chip.active {
  background: #1a1a1a;
  color: #fff;
}
.count-row {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cloth-card {
  width: 340rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.cloth-img {
  width: 100%;
  height: 340rpx;
  background: #f0f0f0;
}
.cloth-info {
  padding: 14rpx 18rpx 18rpx;
}
.cloth-name {
  font-size: 26rpx;
  color: #222;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cloth-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.tag {
  font-size: 20rpx;
  color: #666;
  background: #f4f4f4;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}
.tag.worn {
  color: #b8860b;
  background: #faf3e0;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}
.loading {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 24rpx 0;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1a1a1a;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}
