.search-bar {
  margin-bottom: 20rpx;
}
.search-input {
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 26rpx;
}
.cat-tabs {
  margin-bottom: 20rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cloth-card {
  width: 335rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.cloth-img {
  width: 100%;
  height: 335rpx;
  background: #f0f0f0;
}
.cloth-name {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}
