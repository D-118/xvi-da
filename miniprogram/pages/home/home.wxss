.container {
  padding: 28rpx 28rpx 60rpx;
}
.greet-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}
.greet {
  font-size: 38rpx;
  font-weight: 700;
}
.date {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.mini-stats {
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 14rpx 28rpx;
}
.stat-num {
  font-size: 32rpx;
  font-weight: 600;
}
.stat-label {
  font-size: 20rpx;
  color: #999;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.showcase { min-height: 480rpx; }
.showcase-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}
.showcase-title {
  font-size: 32rpx;
  font-weight: 600;
}
.showcase-sub {
  font-size: 24rpx;
  color: #999;
}
.spotlight {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  justify-content: center;
}
.showcase-img {
  width: 200rpx;
  height: 240rpx;
  border-radius: 16rpx;
  background: #f4f4f4;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.08);
}
.showcase-note {
  margin-top: 22rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 27rpx;
  padding: 50rpx 0 30rpx;
}
.empty-icon {
  font-size: 76rpx;
  display: block;
  margin-bottom: 18rpx;
}
.empty-sub {
  font-size: 23rpx;
  color: #bbb;
  margin-top: 8rpx;
}
.btn-primary {
  background: #1a1a1a;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.go-btn {
  margin: 40rpx 60rpx 0;
}
.quick-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.quick-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.quick-icon { font-size: 40rpx; }
.quick-num {
  font-size: 30rpx;
  font-weight: 600;
}
.quick-label {
  font-size: 22rpx;
  color: #999;
}
.weather-bar {
  display: flex;
  align-items: center;
}
.weather-text {
  color: #666;
  font-size: 26rpx;
}
