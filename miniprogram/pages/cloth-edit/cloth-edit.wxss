.container {
  padding: 24rpx 32rpx 80rpx;
}
.section {
  margin-bottom: 32rpx;
}
.section-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
}
.img-picker {
  height: 340rpx;
  background: #fff;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.picker-icon { font-size: 64rpx; }
.picker-text { font-size: 26rpx; color: #999; }
.img-preview-wrap { position: relative; }
.img-preview {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
}
.img-hint {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.4);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.input {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.chip {
  background: #fff;
  color: #555;
  border-radius: 30rpx;
  padding: 12rpx 30rpx;
  font-size: 26rpx;
}
.chip.active {
  background: #1a1a1a;
  color: #fff;
}
.row2 {
  display: flex;
  gap: 24rpx;
}
.half { flex: 1; }
.submit-btn {
  margin-top: 40rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
