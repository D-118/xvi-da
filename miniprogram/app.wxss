/* XVI・搭 全局样式 */
page {
  background: #f6f6f6;
  font-size: 28rpx;
  color: #1a1a1a;
}

.container {
  padding: 24rpx;
}

/* 统一卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: #1a1a1a;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 4rpx 0;
}

/* 空态 */
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 26rpx;
}

/* 标签 chip */
.chip {
  display: inline-block;
  padding: 4rpx 20rpx;
  border-radius: 24rpx;
  background: #f2f2f2;
  color: #666;
  font-size: 24rpx;
  margin-right: 12rpx;
}
.chip.active {
  background: #1a1a1a;
  color: #fff;
}
